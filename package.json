{
	"name": "@ktarmyshov/income-tax",
	"description": "Calculate German income tax (Einkommensteuer) and solidarity surcharge from annual taxable income (zvE), with Ehegattensplitting. TypeScript, 2021-2026.",
	"version": "0.1.9",
	"license": "MIT",
	"author": {
		"name": "Konstantin Tarmyshov",
		"email": "k.tarmyshov@googlemail.com"
	},
	"keywords": [
		"germany",
		"german-tax",
		"german-income-tax",
		"income-tax",
		"tax-calculator",
		"einkommensteuer",
		"einkommensteuerrechner",
		"steuerrechner",
		"taxable-income",
		"zve",
		"solidaritaetszuschlag",
		"solidarity-surcharge",
		"ehegattensplitting",
		"splittingtarif",
		"typescript",
		"javascript"
	],
	"homepage": "https://github.com/kt-npm-modules/income-tax#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kt-npm-modules/income-tax.git"
	},
	"bugs": {
		"url": "https://github.com/kt-npm-modules/income-tax/issues"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./de": {
			"types": "./dist/de/index.d.ts",
			"import": "./dist/de/index.js",
			"default": "./dist/de/index.js"
		}
	},
	"scripts": {
		"build": "rimraf ./dist && tsc --project tsconfig.json && npm run prepack",
		"build:release": "rimraf ./dist && tsc --project tsconfig-release.json && npm run prepack",
		"prepack": "publint",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && npm run lint:licenses",
		"lint:licenses": "license-gate check",
		"check": "tsc --project tsconfig.json --noEmit",
		"check:test": "tsc --project tsconfig-test.json",
		"test": "npm run build && npm run check:test && vitest run",
		"coverage": "npm run build && npm run check:test && vitest run --coverage",
		"changeset:version": "changeset version && npm install && git add --all",
		"changeset:publish": "changeset publish",
		"bmf:update-fixtures": "node --import tsx tests/de/bmf/update-fixtures.ts",
		"test:bmf": "npm run build && npm run check:test && vitest run --config vitest.bmf.config.ts"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@mirasen/license-gate": "^1.0.4",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"dependencies": {
		"@ktarmyshov/assert": "^0.1.15",
		"decimal.js": "^10.6.0",
		"type-fest": "^5.10.0"
	}
}
